{
  "name": "json-render-vue-monorepo",
  "version": "0.0.1-beta.1",
  "private": true,
  "packageManager": "pnpm@9.15.3",
  "description": "Vue 3 implementation of json-render framework",
  "author": {
    "name": "zwkang",
    "email": "kang95630@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZWkang/json-render-vue.git"
  },
  "bugs": "https://github.com/ZWkang/json-render-vue/issues",
  "keywords": [
    "vue",
    "json-render",
    "ui-framework"
  ],
  "scripts": {
    "dev": "pnpm -r --filter=./packages/** run dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm -r --filter=./packages/** run test",
    "build": "pnpm -r --filter=./packages/** run build",
    "typecheck": "pnpm -r --filter=./packages/** run typecheck",
    "release": "bumpp -r --commit --push --tag --all && git push --follow-tags",
    "publish:ci": "pnpm -r publish --access public --no-git-checks",
    "update:deps": "taze major -lr"
  },
  "dependencies": {
    "@json-render/core": "^0.4.0",
    "taze": "^19.9.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^2.16.0",
    "bumpp": "^9.4.1",
    "eslint": "^9.1.1",
    "prettier": "^3.1.0",
    "tsup": "^8.0.2",
    "tsx": "^4.7.3",
    "typescript": "^5.4.5",
    "vitest": "^1.5.3",
    "zwkang-prettier-config": "^0.0.3"
  }
}
