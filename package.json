{
  "version": "0.0.1-beta.12",
  "packageManager": "pnpm@8.15.8",
  "description": "> description:",
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "zwkang",
    "email": "kang95630@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zwkang/monorepo-template.git"
  },
  "bugs": "https://github.com/zwkang/monorepo-template/issues",
  "keywords": [],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./dist/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "pnpm -r --filter=./packages/** run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm -r --filter=./packages/** run test",
    "build": "pnpm -r --filter=./packages/** run build",
    "start": "pnpm -r --filter=./packages/** run start",
    "release": "bumpp -r --all",
    "bump:version": "bumpp",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "publish:all": "pnpm -r publish --access public --no-git-checks",
    "update:deps": "taze "
  },
  "dependencies": {
    "@json-render/core": "^0.4.0",
    "taze": "^19.9.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^2.16.0",
    "bumpp": "^9.4.1",
    "eslint": "^9.1.1",
    "prettier": "^3.1.0",
    "tsup": "^8.0.2",
    "tsx": "^4.7.3",
    "typescript": "^5.4.5",
    "vitest": "^1.5.3",
    "zwkang-prettier-config": "^0.0.3"
  }
}
