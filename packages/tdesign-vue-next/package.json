{
  "name": "@zwkang-dev/json-render-tdesign-vue-next",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@8.15.8",
  "description": "TDesign Vue Next components for json-render-vue",
  "publishConfig": {
    "access": "public"
  },
  "author": {
